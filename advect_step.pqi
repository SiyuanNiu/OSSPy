DATABASE C:\Program Files\USGS\phreeqc-3.8.6-17100-x64\database\llnl(reedited)_2021_SEP_15_Tc_Th_U_Np_Am_Se_B-Li-EPRIV-PO4.dat
SOLUTION 0
    temp      25
    pH        7.64
    pe        4
    redox     pe
    units     mg/l
    density   1
    Cl(-1)    368
    Na        368
    -water    1 # kg


EQUILIBRIUM_PHASES 0
    CO2(g)    0.9943 10
    O2(g)     0.9943 10
       

INCLUDE$ em_solutions.pqi


TRANSPORT
    -cells                 10
    -shifts                1               
    -time_step             0.0029 day
    -boundary_conditions   constant flux
    -flow_direction  forward   
    -lengths               10*0.0045
    -porosity              10*0.3
    -dispersivities        10*0.002
    -punch_cells           10
    -punch_frequency       1
    -multi_d               true 1e-009 


USER_PUNCH 1
    -headings Time  U_mgL U6_mgL U4_mgL 
    -start
10 PUNCH TOTAL_TIME/3600/24
20 PUNCH TOT("U") * 238 * 1000
30 PUNCH TOT("U(6)") *  238* 1000
40 PUNCH TOT("U(4)") * 238* 1000
    -end

SELECTED_OUTPUT
    -file adv_selected_out_1.sel
    -reset false
    -time true
    -totals U U(6) U(4) Na Cl H OH

DUMP
    -file adv_solutions.pqi
    -solutions 1-10
    -equilibrium_phases 1-10
END